{
  "name": "titration_pairs_react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:https": "vite --mode https",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --mode pages --outDir dist-pages && node -e \"require('node:fs').copyFileSync('dist-pages/index.html', 'dist-pages/404.html')\"",
    "deploy": "npm run build:pages && gh-pages -d dist-pages --nojekyll",
    "lint": "oxlint",
    "preview": "vite preview",
    "preview:https": "vite preview --mode https",
    "codegen": "swagger-typescript-api generate -p http://localhost:3000/api-json -o ./src/api -n Api.ts --axios --type-only-imports --enum-style=union"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.14.0",
    "axios": "^1.21.1",
    "bootstrap": "^5.3.8",
    "react": "^19.3.1",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.3.1",
    "react-redux": "^9.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "gh-pages": "^6.3.0",
    "mkcert": "^3.2.0",
    "oxlint": "^1.88.0",
    "swagger-typescript-api": "^13.13.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-mkcert": "^2.1.0",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-precaching": "^7.4.1",
    "workbox-range-requests": "^7.4.1",
    "workbox-routing": "^7.4.1"
  }
}
