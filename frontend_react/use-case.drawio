<mxfile host="app.diagrams.net">
  <diagram id="use-case" name="Диаграмма прецедентов">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Граница системы -->
        <mxCell id="system" value="React приложение" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;verticalAlign=top;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="150" y="10" width="830" height="770" as="geometry" />
        </mxCell>
        <mxCell id="package" value="Интерфейс пользователя" style="shape=folder;fontStyle=1;tabWidth=330;tabHeight=14;tabPosition=left;html=1;boundedLbl=1;whiteSpace=wrap;fillColor=none;verticalAlign=top;spacingTop=4;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="160" y="35" width="810" height="735" as="geometry" />
        </mxCell>

        <!-- Актёры -->
        <mxCell id="guest" value="Гость" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="50" y="200" width="30" height="60" as="geometry" />
        </mxCell>
        <mxCell id="user" value="Пользователь" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="50" y="560" width="30" height="60" as="geometry" />
        </mxCell>
        <mxCell id="gen" style="endArrow=block;endFill=0;endSize=12;html=1;" edge="1" parent="1" source="user" target="guest">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="65" y="530" as="sourcePoint" />
            <mxPoint x="65" y="300" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Прецеденты гостя -->
        <mxCell id="feed" value="Посмотреть ленту услуг" style="ellipse;whiteSpace=wrap;html=1;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="200" y="90" width="210" height="60" as="geometry" />
        </mxCell>
        <mxCell id="next" value="Перейти к следующей услуге" style="ellipse;whiteSpace=wrap;html=1;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="560" y="60" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="desc" value="Развернуть описание услуги" style="ellipse;whiteSpace=wrap;html=1;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="560" y="140" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="grid" value="Посмотреть плитку услуг" style="ellipse;whiteSpace=wrap;html=1;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="200" y="250" width="210" height="60" as="geometry" />
        </mxCell>
        <mxCell id="filter" value="Отфильтровать услуги по концентрации" style="ellipse;whiteSpace=wrap;html=1;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="560" y="220" width="250" height="70" as="geometry" />
        </mxCell>
        <mxCell id="open" value="Открыть услугу в ленте" style="ellipse;whiteSpace=wrap;html=1;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="560" y="310" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="login" value="Авторизоваться" style="ellipse;whiteSpace=wrap;html=1;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="200" y="390" width="210" height="50" as="geometry" />
        </mxCell>

        <!-- Прецеденты пользователя -->
        <mxCell id="add" value="Добавить услугу" style="ellipse;whiteSpace=wrap;html=1;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="200" y="480" width="210" height="50" as="geometry" />
        </mxCell>
        <mxCell id="like" value="Поставить или снять лайк" style="ellipse;whiteSpace=wrap;html=1;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="200" y="560" width="210" height="60" as="geometry" />
        </mxCell>
        <mxCell id="delete" value="Удалить свою услугу" style="ellipse;whiteSpace=wrap;html=1;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="200" y="645" width="210" height="50" as="geometry" />
        </mxCell>
        <mxCell id="logout" value="Выйти" style="ellipse;whiteSpace=wrap;html=1;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="200" y="710" width="210" height="45" as="geometry" />
        </mxCell>

        <!-- Ассоциации гостя -->
        <mxCell id="a1" style="endArrow=none;html=1;" edge="1" parent="1" source="guest" target="feed">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a2" style="endArrow=none;html=1;" edge="1" parent="1" source="guest" target="grid">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a3" style="endArrow=none;html=1;" edge="1" parent="1" source="guest" target="login">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Ассоциации пользователя -->
        <mxCell id="a4" style="endArrow=none;html=1;" edge="1" parent="1" source="user" target="add">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a5" style="endArrow=none;html=1;" edge="1" parent="1" source="user" target="like">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a6" style="endArrow=none;html=1;" edge="1" parent="1" source="user" target="delete">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a7" style="endArrow=none;html=1;" edge="1" parent="1" source="user" target="logout">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Расширения «extend» -->
        <mxCell id="e1" value="«extend»" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=13;" edge="1" parent="1" source="next" target="feed">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="«extend»" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=13;" edge="1" parent="1" source="desc" target="feed">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="«extend»" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=13;" edge="1" parent="1" source="filter" target="grid">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="«extend»" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=13;" edge="1" parent="1" source="open" target="grid">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
